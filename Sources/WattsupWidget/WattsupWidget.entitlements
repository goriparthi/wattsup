<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS only registers sandboxed widgets. No App Group, which would need a provisioning
         profile; the app writes into this extension's own container instead. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
